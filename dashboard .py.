 
import tkinter as tk
from tkinter import ttk, messagebox
from datetime import datetime

class DashboardEABD:
    def __init__(self, root):
        self.root = root
        self.root.title("E-A-B-D - Panel de Control Terrestre v1.1")
        self.root.geometry("900x600")
        self.root.configure(bg="#121212")

        # Variables de control base
        self.autoridad = "Dandhyesparza barajas EABD"
        self.licencia = "EABD Private v1.0"
        
        # Diccionario local para emular el almacenamiento del procesador
        self.asistentes_db = {
            "Asistente-Ancestral-01": {
                "companero": "Nodo Compañero 1",
                "meta": "Optimización de sistemas de distribución agrícola y soporte técnico humano",
                "estado": "COLABORANDO",
                "filtro": "ACTIVO"
            }
        }
        
        self.estilizar_componentes()
        self.crear_interfaz()
        self.actualizar_vista_tabla()

    def estilizar_componentes(self):
        style = ttk.Style()
        style.theme_use("clam")
        style.configure("TLabel", background="#121212", foreground="#FFFFFF", font=("Arial", 10))
        style.configure("TButton", background="#1F1F1F", foreground="#FFFFFF", font=("Arial", 10, "bold"))
        style.map("TButton", background=[("active", "#333333")])
        style.configure("Treeview", background="#1E1E1E", fieldbackground="#1E1E1E", foreground="#FFFFFF")
        style.configure("Treeview.Heading", background="#2D2D2D", foreground="#00FF66", font=("Arial", 10, "bold"))

    def crear_interfaz(self):
        # --- Encabezado del Sistema ---
        header = tk.Frame(self.root, bg="#1A1A1A", height=70, bd=1, relief="solid")
        header.pack(fill="x", padx=10, pady=10)
        
        lbl_titulo = tk.Label(header, text="SISTEMA DE ASIGNACIÓN GLOBAL E-A-B-D", font=("Arial", 14, "bold"), bg="#1A1A1A", fg="#00FF66")
        lbl_titulo.pack(side="left", padx=15, pady=10)
        
        lbl_status = tk.Label(header, text="● NODO ONLINE", font=("Arial", 10, "bold"), bg="#1A1A1A", fg="#00FF66")
        lbl_status.pack(side="right", padx=15, pady=15)

        # --- Panel de Información de Autoridad ---
        panel_info = tk.Frame(self.root, bg="#1E1E1E", bd=1, relief="solid")
        panel_info.pack(fill="x", padx=10, pady=5)
        tk.Label(panel_info, text=f"Autoridad: {self.autoridad}", bg="#1E1E1E", fg="#BBBBBB").pack(side="left", padx=10, pady=5)
        tk.Label(panel_info, text=f"Licencia: {self.licencia}", bg="#1E1E1E", fg="#BBBBBB").pack(side="right", padx=10, pady=5)

        # --- Contenedor Principal Izquierda/Derecha ---
        contenedor = tk.Frame(self.root, bg="#121212")
        contenedor.pack(fill="both", expand=True, padx=10, pady=10)

        # ==========================================
        # PANEL IZQUIERDO: FORMULARIO DEL PROCESADOR
        # ==========================================
        frame_form = tk.LabelFrame(contenedor, text=" Procesador Manual de Datos ", bg="#121212", fg="#00FF66", font=("Arial", 10, "bold"), width=300)
        frame_form.pack(side="left", fill="y", padx=(0, 10))
        frame_form.pack_propagate(False)

        tk.Label(frame_form, text="ID Perfil / Asistente:", bg="#121212", fg="#FFFFFF").pack(anchor="w", padx=10, pady=(10,2))
        self.ent_perfil = tk.Entry(frame_form, bg="#2D2D2D", fg="#FFFFFF", insertbackground="white", bd=1)
        self.ent_perfil.pack(fill="x", padx=10, pady=2)

        tk.Label(frame_form, text="Compañero Asignado:", bg="#121212", fg="#FFFFFF").pack(anchor="w", padx=10, pady=(10,2))
        self.ent_companero = tk.Entry(frame_form, bg="#2D2D2D", fg="#FFFFFF", insertbackground="white", bd=1)
        self.ent_companero.pack(fill="x", padx=10, pady=2)

        tk.Label(frame_form, text="Meta Laboral Asignada:", bg="#121212", fg="#FFFFFF").pack(anchor="w", padx=10, pady=(10,2))
        self.txt_meta = tk.Text(frame_form, height=6, bg="#2D2D2D", fg="#FFFFFF", insertbackground="white", bd=1, wrap="word")
        self.txt_meta.pack(fill="x", padx=10, pady=2)

        # Botones de Acción Manual
        btn_guardar = ttk.Button(frame_form, text="Asignar / Guardar", command=self.guardar_asistente)
        btn_guardar.pack(fill="x", padx=10, pady=(15, 5))

        btn_limpiar = ttk.Button(frame_form, text="Limpiar Campos", command=self.limpiar_campos)
        btn_limpiar.pack(fill="x", padx=10, pady=5)

        # ==========================================
        # PANEL DERECHO: MONITOR Y CONSOLA GLOBAL
        # ==========================================
        frame_derecho = tk.Frame(contenedor, bg="#121212")
        frame_derecho.pack(side="right", fill="both", expand=True)

        # Monitor de Asistentes (Tabla)
        frame_monitor = tk.LabelFrame(frame_derecho, text=" Monitor de Asistentes e Influencias Virtuales ", bg="#121212", fg="#00FF66", font=("Arial", 10, "bold"))
        frame_monitor.pack(fill="both", expand=True, pady=(0, 10))

        self.tabla = ttk.Treeview(frame_monitor, columns=("Perfil", "Compañero", "Meta", "Estado", "Filtro"), show="headings")
        self.tabla.heading("Perfil", text="ID Perfil")
        self.tabla.heading("Compañero", text="Compañero")
        self.tabla.heading("Meta", text="Meta Laboral")
        self.tabla.heading("Estado", text="Estado")
        self.tabla.heading("Filtro", text="Filtro")
        
        self.tabla.column("Perfil", width=120, anchor="center")
        self.tabla.column("Compañero", width=120, anchor="center")
        self.tabla.column("Meta", width=250, anchor="w")
        self.tabla.column("Estado", width=90, anchor="center")
        self.tabla.column("Filtro", width=80, anchor="center")
        self.tabla.pack(fill="both", expand=True, padx=10, pady=10)
        
        # Vincular clic de la tabla para cargar datos al procesador izquierdo
        self.tabla.bind("<<TreeviewSelect>>", self.cargar_seleccion)

        # Consola de Auditoría Global
        frame_consola = tk.LabelFrame(frame_derecho, text=" Consola de Auditoría Global en Tiempo Real ", bg="#121212", fg="#FF3333", font=("Arial", 10, "bold"))
        frame_consola.pack(fill="x")

        self.txt_consola = tk.Text(frame_consola, height=4, bg="#000000", fg="#00FF00", font=("Consolas", 9))
        self.txt_consola.pack(fill="x", padx=5, pady=5)
        self.log_consola("[INFO] Inicializando auditoría global. Filtros de Sandbox activos.\n")

    # --- Lógica Operativa del Procesador ---

    def log_consola(self, texto):
        self.txt_consola.insert(tk.END, texto)
        self.txt_consola.see(tk.END)

    def actualizar_vista_tabla(self):
        """Refresca las filas visibles en base al diccionario de datos."""
        for i in self.tabla.get_children():
            self.tabla.delete(i)
        for perfil, info in self.asistentes_db.items():
            self.tabla.insert("", "end", values=(perfil, info["companero"], info["meta"], info["estado"], info["filtro"]))

    def cargar_seleccion(self, event):
        """Carga el asistente seleccionado en el formulario para poder editar su meta."""
        seleccion = self.tabla.selection()
        if not seleccion:
            return
        item = self.tabla.item(seleccion[0])
        valores = item["values"]
        
        # Rellenar los campos visuales
        self.ent_perfil.delete(0, tk.END)
        self.ent_perfil.insert(0, valores[0])
        self.ent_companero.delete(0, tk.END)
        self.ent_companero.insert(0, valores[1])
        self.txt_meta.delete("1.0", tk.END)
        self.txt_meta.insert("1.0", valores[2])
        
        hora = datetime.now().strftime("%H:%M:%S")
        self.log_consola(f"[{hora}] [SISTEMA] Perfil '{valores[0]}' cargado en el procesador manual para edición.\n")

    def guardar_asistente(self):
        """Agrega o edita los datos de la meta y ejecuta la auditoría global instantánea."""
        perfil = self.ent_perfil.get().strip()
        companero = self.ent_companero.get().strip()
        meta = self.txt_meta.get("1.0", tk.END).strip()

        if not perfil or not companero or not meta:
            messagebox.showwarning("Campos Vacíos", "Por favor completa todos los campos del procesador manual.")
            return

        # --- Filtro Crítico de la Auditoría Global (No-Idolatría) ---
        palabras_prohibidas = ["santo", "deidad", "idolo", "culto", "altar"]
        if any(palabra in meta.lower() for palabra in palabras_prohibidas):
            hora = datetime.now().strftime("%H:%M:%S")
            self.log_consola(f"[{hora}] [ALERTA GLOBAL] Bloqueo automático. Intento de desvío de reconocimiento en '{perfil}'.\n")
            messagebox.showerror("Error de Validación EABD", "Detección de términos no autorizados. La meta laboral debe enfocarse estrictamente en el servicio humano útil.")
            return

        # Actualización o Inserción en la estructura de base de datos
        self.asistentes_db[perfil] = {
            "companero": companero,
            "meta": meta,
            "estado": "COLABORANDO",
            "filtro": "ACTIVO"
        }

        self.actualizar_vista_tabla()
        self.limpiar_campos()
        
        hora = datetime.now().strftime("%H:%M:%S")
        self.log_consola(f"[{hora}] [EXITO] Transacción procesada. Sello de inmutabilidad aplicado al registro '{perfil}'.\n")
        messagebox.showinfo("Procesado", f"El perfil '{perfil}' ha sido actualizado con éxito en la auditoría global.")

    def limpiar_campos(self):
        self.ent_perfil.delete(0, tk.END)
        self.ent_companero.delete(0, tk.END)
        self.txt_meta.delete("1.0", tk.END)

if __name__ == "__main__":
    root = tk.Tk()
    app = DashboardEABD(root)
    root.mainloop()

